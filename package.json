{
  "name": "json-pub-sub",
  "version": "1.0.3",
  "description": "A user-isolated, file-based publish/subscribe system for Node.js.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start:publisher": "tsx src/tests/publisher.ts",
    "start:subscriber": "tsx src/tests/subscriber.ts"
  },
  "keywords": [
    "pub sub system",
    "json-pub-sub",
    "persisting",
    "lock based"
  ],
  "author": "Navnath Kadam",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "tsconfig.json",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "dependencies": {
    "json-pub-sub": "^1.0.1",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
